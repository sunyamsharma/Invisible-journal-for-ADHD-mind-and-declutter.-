# Invicti REST API (Settings > API in the Invicti web UI for your tenant)
INVICTI_API_URL=https://your-invicti-instance.example.com/api/1.0
INVICTI_API_ID=
INVICTI_API_KEY=
# Optional: a saved scan policy/profile id to use instead of Invicti's default
INVICTI_PROFILE_ID=

# Burp Suite Professional REST API (Settings > Suite > REST API)
BURP_API_URL=http://127.0.0.1:1337
BURP_API_KEY=
